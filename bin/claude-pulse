#!/bin/bash
# Update GitHub bio with active coding agent session count.
# Requires: gh CLI authenticated with 'user' scope
# Usage: claude-pulse [--dry-run | --no-loop | --loop [interval_seconds] | -d | --stop | --status]
# Default: run immediately, then loop on CLAUDE_PULSE_INTERVAL (10 min)

# Load config (defaults first, then user config overrides)
CLAUDE_PULSE_INTERVAL=600
CLAUDE_PULSE_WINDOW=1800
CLAUDE_PULSE_AGENTS="claude cursor copilot"
CLAUDE_PULSE_BIO="🤖 × \$COUNT coding agents active"
CLAUDE_PULSE_CLAUDE_SESSIONS_DIR="$HOME/.claude/sessions"
CLAUDE_PULSE_CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"
CLAUDE_PULSE_CURSOR_PROJECTS_DIR="$HOME/.cursor/projects"
CLAUDE_PULSE_COPILOT_SESSIONS_DIR="$HOME/.copilot/session-state"
[ -f "$HOME/.config/claude-pulse/config" ] && source "$HOME/.config/claude-pulse/config"
if [ "$CLAUDE_PULSE_BIO" = "🤖 × \$COUNT Claude agents active" ]; then
    CLAUDE_PULSE_BIO="🤖 × \$COUNT coding agents active"
fi

PID_FILE="/tmp/claude-pulse.pid"
LOG_FILE="$HOME/.local/share/claude-pulse.log"
COUNT=0
CLAUDE_COUNT=0
CURSOR_COUNT=0
COPILOT_COUNT=0

clear_bio() {
    echo ""
    echo "Clearing GitHub bio..."
    GITHUB_TOKEN="" gh api -X PATCH /user -f bio="" > /dev/null \
        && echo "Bio cleared." \
        || echo "Failed to clear bio." >&2
    exit 0
}

# Count active Claude Code sessions by observing Claude Code's own state:
#   ~/.claude/sessions/<pid>.json        → pid + sessionId for every session
#   ~/.claude/projects/<dir>/<sid>.jsonl → conversation transcript, mtime
#                                          updates on every message exchange
# Active ≝ process still alive AND transcript modified within CLAUDE_PULSE_WINDOW.
# Works without any hook registration, so existing sessions count immediately —
# no restart needed — and there's no risk of a hook-path regression.
count_claude_sessions() {
    local count=0
    local cutoff=$(($(date +%s) - CLAUDE_PULSE_WINDOW))
    [ -d "$CLAUDE_PULSE_CLAUDE_SESSIONS_DIR" ] && [ -d "$CLAUDE_PULSE_CLAUDE_PROJECTS_DIR" ] || { echo 0; return; }
    command -v jq >/dev/null 2>&1 || { echo 0; return; }

    for f in "$CLAUDE_PULSE_CLAUDE_SESSIONS_DIR"/*.json; do
        [ -f "$f" ] || continue
        local pid sid jsonl candidate mtime
        pid=$(basename "$f" .json)
        kill -0 "$pid" 2>/dev/null || continue
        sid=$(jq -r '.sessionId // empty' "$f" 2>/dev/null)
        [ -z "$sid" ] && continue

        jsonl=""
        for candidate in "$CLAUDE_PULSE_CLAUDE_PROJECTS_DIR"/*/"${sid}.jsonl"; do
            [ -f "$candidate" ] || continue
            jsonl="$candidate"
            break
        done
        [ -z "$jsonl" ] && continue
        mtime=$(stat -f %m "$jsonl" 2>/dev/null)
        [ -n "$mtime" ] && [ "$mtime" -gt "$cutoff" ] && count=$((count + 1))
    done
    echo "$count"
}

count_cursor_sessions() {
    local count=0
    local cutoff=$(($(date +%s) - CLAUDE_PULSE_WINDOW))
    local f mtime
    [ -d "$CLAUDE_PULSE_CURSOR_PROJECTS_DIR" ] || { echo 0; return; }

    for f in "$CLAUDE_PULSE_CURSOR_PROJECTS_DIR"/*/agent-transcripts/*/*.jsonl; do
        [ -f "$f" ] || continue
        mtime=$(stat -f %m "$f" 2>/dev/null)
        [ -n "$mtime" ] && [ "$mtime" -gt "$cutoff" ] && count=$((count + 1))
    done
    echo "$count"
}

count_copilot_sessions() {
    local count=0
    local cutoff=$(($(date +%s) - CLAUDE_PULSE_WINDOW))
    local f mtime
    [ -d "$CLAUDE_PULSE_COPILOT_SESSIONS_DIR" ] || { echo 0; return; }

    for f in "$CLAUDE_PULSE_COPILOT_SESSIONS_DIR"/*/events.jsonl; do
        [ -f "$f" ] || continue
        mtime=$(stat -f %m "$f" 2>/dev/null)
        [ -n "$mtime" ] && [ "$mtime" -gt "$cutoff" ] && count=$((count + 1))
    done
    echo "$count"
}

count_all_sessions() {
    COUNT=0
    CLAUDE_COUNT=0
    CURSOR_COUNT=0
    COPILOT_COUNT=0

    local agent agent_count
    for agent in $CLAUDE_PULSE_AGENTS; do
        case "$agent" in
            claude)
                agent_count=$(count_claude_sessions)
                CLAUDE_COUNT=$agent_count
                ;;
            cursor)
                agent_count=$(count_cursor_sessions)
                CURSOR_COUNT=$agent_count
                ;;
            copilot)
                agent_count=$(count_copilot_sessions)
                COPILOT_COUNT=$agent_count
                ;;
            *)
                continue
                ;;
        esac
        COUNT=$((COUNT + agent_count))
    done
}

session_breakdown() {
    echo "Claude: $CLAUDE_COUNT, Cursor: $CURSOR_COUNT, Copilot: $COPILOT_COUNT"
}

run_once() {
    count_all_sessions

    BIO=$(eval echo "$CLAUDE_PULSE_BIO")
    if GITHUB_TOKEN="" gh api -X PATCH /user -f bio="$BIO" > /dev/null; then
        echo "[$(date '+%H:%M:%S')] GitHub bio set to '$BIO' ($(session_breakdown))"
    else
        echo "[$(date '+%H:%M:%S')] Failed to update GitHub bio" >&2
    fi
}

is_running() {
    [ -f "$PID_FILE" ] || return 1
    PID=$(cat "$PID_FILE")
    kill -0 "$PID" 2>/dev/null || return 1
    ps -p "$PID" -o args= 2>/dev/null | grep -q "claude-pulse" || return 1
    return 0
}

daemon_start() {
    if is_running; then
        echo "Already running (PID $(cat "$PID_FILE")). Use --stop first."
        exit 1
    fi
    rm -f "$PID_FILE"
    mkdir -p "$(dirname "$LOG_FILE")"
    # subshell + setsid-equivalent: child is reparented to launchd on subshell exit
    (nohup "$0" </dev/null >> "$LOG_FILE" 2>&1 & echo $! > "$PID_FILE")
    sleep 0.2
    PID=$(cat "$PID_FILE")
    echo "Started (PID $PID). Logs: $LOG_FILE"
}

daemon_stop() {
    if ! is_running; then
        echo "Not running."
        rm -f "$PID_FILE"
        exit 0
    fi
    kill "$(cat "$PID_FILE")"
    rm -f "$PID_FILE"
    echo "Stopped."
    echo "Clearing GitHub bio..."
    GITHUB_TOKEN="" gh api -X PATCH /user -f bio="" > /dev/null \
        && echo "Bio cleared." \
        || echo "Failed to clear bio." >&2
}

daemon_status() {
    if is_running; then
        echo "Running (PID $(cat "$PID_FILE"))"
        echo ""
        tail -5 "$LOG_FILE" 2>/dev/null
    else
        echo "Not running."
    fi
}

case "$1" in
    -h|--help)
        cat <<EOF
Usage: claude-pulse [options]

Options:
  (no args)        Run immediately, then loop every CLAUDE_PULSE_INTERVAL (default: 10 min)
  -d, --start      Start as background daemon
  --stop           Stop daemon and clear GitHub bio
  --status         Show daemon status and last log lines
  --sync           Force immediate bio update
  --loop [secs]    Run immediately, then loop every N seconds (default: CLAUDE_PULSE_INTERVAL)
  --no-loop        Run once and exit
  --dry-run        Show current session counts without updating GitHub
  -h, --help       Show this help

Config: ~/.config/claude-pulse/config
Logs:   $LOG_FILE
EOF
        ;;
    --sync)
        run_once
        ;;
    -d|--start)
        daemon_start
        ;;
    --stop)
        daemon_stop
        ;;
    --status)
        daemon_status
        ;;
    --dry-run)
        count_all_sessions
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] $COUNT active coding agent session(s) ($(session_breakdown))"
        ;;
    --no-loop)
        run_once
        ;;
    --loop)
        [ -n "$2" ] && CLAUDE_PULSE_INTERVAL="$2"
        trap clear_bio INT TERM
        run_once
        echo "Looping every ${CLAUDE_PULSE_INTERVAL}s. Ctrl+C to stop."
        while true; do
            sleep "$CLAUDE_PULSE_INTERVAL"
            run_once
        done
        ;;
    *)
        # Default: run immediately, then loop
        trap clear_bio INT TERM
        run_once
        echo "Looping every ${CLAUDE_PULSE_INTERVAL}s. Ctrl+C to stop."
        while true; do
            sleep "$CLAUDE_PULSE_INTERVAL"
            run_once
        done
        ;;
esac
